{
  "name": "carnet",
  "version": "0.1.0",
  "description": "Software público de gestión de casos y seguimiento de acuerdos para equipos de atención en territorio.",
  "license": "AGPL-3.0-or-later",
  "author": "diegmon",
  "repository": {
    "type": "git",
    "url": "https://github.com/diegmon/carnet.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.app.json",
    "build:receptor": "node scripts/build-receptor.mjs",
    "diccionario": "tsx scripts/diccionario.ts",
    "dev": "vite",
    "build:app": "python3 scripts/iconos.py && vite build",
    "preview": "vite preview --port 4173"
  },
  "dependencies": {
    "idb-keyval": "^6.3.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@google/clasp": "2.4.2",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.4",
    "@types/google-apps-script": "^1.0.83",
    "esbuild": "^0.24.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^2.1.0"
  }
