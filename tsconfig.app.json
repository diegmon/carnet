{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vite/client"
    ],
    "resolveJsonModule": true,
    "paths": {
      "@perfil": [
        "./perfil.ejemplo.json"
      ]
    }
  },
  "include": [
    "app/src",
    "test/app",
    "src/dominio",
    "src/receptor"
  ],
  "exclude": [
    "src/receptor/sheets.ts",
    "src/receptor/main.ts"
  ]
}
